# Local / Compose environment
# Copy to .env and adjust. docker compose reads .env automatically.
# Defaults already match a local developer machine — this file is optional.

POSTGRES_DB=inventory_management
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=inventory_password
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

SPRING_PROFILES_ACTIVE=dev

# Dev-only default. Do not use this value with SPRING_PROFILES_ACTIVE=prod.
APP_JWT_SECRET=inventory-management-system-super-secret-key-for-development-only-2026

# Used in verify-email and password-reset links.
APP_PUBLIC_APP_URL=http://localhost:3000
APP_MAIL_FROM=noreply@inventory.local

# Optional SMTP. Uncomment to send real auth email instead of logging links.
# Required when SPRING_PROFILES_ACTIVE=prod (the app will not start without it).
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# Optional. Comma-separated browser origins for a split UI host.
# Same-origin Compose (UI at :3000 proxying /api) does not need this.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. POST JSON {"to":"+91...","body":"..."} for phone OTP. If unset, OTP is logged (dev / early prod).
# APP_SMS_WEBHOOK_URL=

# Open registration (OTP / email signup can create a shop). Dev default true. Prod default false.
# APP_OPEN_REGISTRATION=true

# Platform Super Admin (required in prod when registration is closed). Created on first boot if missing.
# APP_PLATFORM_ADMIN_EMAIL=you@example.com
# APP_PLATFORM_ADMIN_PASSWORD=choose-at-least-12-characters
# APP_PLATFORM_ADMIN_RESET=false

# --- Production / shared host ---
# SPRING_PROFILES_ACTIVE=prod
# APP_JWT_SECRET=          # generate a long random secret (>= 32 chars); not the development default
# APP_PUBLIC_APP_URL=https://your-shop.example.com
# APP_OPEN_REGISTRATION=false
# APP_PLATFORM_ADMIN_EMAIL=you@example.com
# APP_PLATFORM_ADMIN_PASSWORD=
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=apikey
# SPRING_MAIL_PASSWORD=
# APP_CORS_ALLOWED_ORIGINS=https://your-shop.example.com
#
# HTTPS (docker compose -f docker-compose.yml -f docker-compose.prod.yml)
# APP_DOMAIN=your-shop.example.com
# ACME_EMAIL=you@your-shop.example.com
